/dev/block/by-name/metadata /metadata ext4 noatime,nosuid,nodev,discard,data=journal,commit=1 wait,readahead_size_kb=128,metadata_csum
/dev/block/by-name/userdata /data f2fs noatime,nosuid,nodev,discard,fsync_mode=nobarrier,reserve_root=32768,resgid=1065,compress_extension=apk,compress_extension=so,compress_extension=vdex,compress_extension=odex,checkpoint_merge,gc_merge,compress_mode=user,compress_cache,atgc,age_extent_cache,inlinecrypt wait,reservedsize=128m,checkpoint=fs,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,fsverity,readahead_size_kb=128
/dev/block/by-name/boot /boot emmc defaults slotselect
/dev/block/by-name/vendor_boot /vendor_boot emmc defaults slotselect
/dev/block/by-name/misc /misc emmc defaults defaults
/devices/platform/soc/11201000.usb0/11200000.xhci* /usb_otg auto defaults voldmanaged=usbotg:auto
