product /product ext4 noatime,ro wait,slotselect,avb,logical,readahead_size_kb=128
system_ext /system_ext erofs ro wait,slotselect,avb=vbmeta_system,logical,readahead_size_kb=128
system_ext /system_ext ext4 noatime,ro wait,slotselect,avb=vbmeta_system,logical,readahead_size_kb=128
odm /odm erofs ro wait,slotselect,avb,logical,readahead_size_kb=128
odm /odm ext4 noatime,ro wait,slotselect,avb,logical,readahead_size_kb=128
