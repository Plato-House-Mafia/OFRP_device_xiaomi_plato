/system_root erofs /dev/block/mapper/system flags=display="System";backup=0;logical;slotselect
/system_ext erofs /dev/block/mapper/system_ext flags=display="System Ext";backup=0;logical;slotselect
/product erofs /dev/block/mapper/product flags=display="Product";backup=0;logical;slotselect
/vendor erofs /dev/block/mapper/vendor flags=display="Vendor";backup=0;logical;slotselect
/odm erofs /dev/block/mapper/odm flags=display="ODM";backup=0;logical;slotselect
/vendor_dlkm erofs /dev/block/mapper/vendor_dlkm flags=display="Vendor DLKM";backup=0;logical;slotselect
/odm_dlkm erofs /dev/block/mapper/odm_dlkm flags=display="ODM DLKM";backup=0;logical;slotselect
/metadata ext4 /dev/block/by-name/metadata flags=display="Metadata";backup=0;canbewiped=0;wipeingui=0
/data f2fs /dev/block/by-name/userdata flags=display="Data (decryption unavailable)";backup=0;canbewiped=0;wipeingui=0
/boot emmc /dev/block/by-name/boot flags=display="Boot";slotselect;backup=1;flashimg=0
/vendor_boot emmc /dev/block/by-name/vendor_boot flags=display="Vendor Boot";slotselect;backup=1;flashimg=0
/misc emmc /dev/block/by-name/misc flags=backup=0;canbewiped=0;flashimg=0
/usb_otg auto /devices/platform/soc/11201000.usb0/11200000.xhci* flags=display="USB OTG";storage;removable;backup=0;canbewiped=0;wipeingui=0
