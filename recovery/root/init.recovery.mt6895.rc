import /init.recovery.xaga-crypto.rc

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "11201000.usb0"
    setprop sys.usb.ffs.aio_compat 1

on boot
    start boot-hal-1-2
    start health-hal-2-1
    setprop sys.usb.config adb

service xaga-recovery-modules /system/bin/sh /system/bin/load-recovery-modules.sh
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0
