--- update-binary
+++ update-binary
@@ -635,6 +635,7 @@
 	   ui_print "- NOTE: vendor_boot-as-recovery is highly experimental! Do not use unless you are absolutely sure that it will not cause problems!"
 
 	   # replace the entire vendor_boot partition ?
+	   [ "$FOX_INSTALLER_VENDOR_BOOT_RAMDISK_INSTALL" = 1 ] || abort "plato requires ramdisk-only installation"
 	   local no_ramdisk_only=0
 	   [ "$FOX_INSTALLER_VENDOR_BOOT_RAMDISK_INSTALL" != "1" ] && no_ramdisk_only=1
 
@@ -671,6 +672,7 @@
 
 	   # dump the vendor_boot partition and unpack
 	   slot=$($GETPROP "ro.boot.slot_suffix")
+	   case "$slot" in _a|_b) ;; *) abort "Invalid current slot" ;; esac
 	   ui_print "- Fetching the $target$slot image..."
 	   dd bs=1048576 if=$target$slot of=$name".img" || abort "- I cannot dump the $name$slot image."
 
@@ -678,7 +680,7 @@
 	   ui_print "- Unpacking the $target$slot image..."
 	   "$tool" unpack -n $name".img"
 	   # after unpacking, there should be - either: ./ramdisk.cpio (v3 header); or ./vendor_ramdisk_recovery.cpio (v4 header + old magiskboot); or vendor_ramdisk/recovery.cpio (v4 header + magiskboot 28.0 and higher)
-	   if [ -e "./ramdisk.cpio" -o -e "./vendor_ramdisk_recovery.cpio" -o -e "./vendor_ramdisk/recovery.cpio" ]; then
+	   if [ -f "./vendor_ramdisk_recovery.cpio" ] || [ -f "./vendor_ramdisk/recovery.cpio" ]; then
 		ui_print "- Finished unpacking the $target$slot image."
 	   else
 		abort "- I cannot unpack the $name$slot image."
@@ -696,18 +698,19 @@
 	   ui_print "- Repacking the ROM's $name$slot image..."
 	   "$tool" repack $name".img" new_recovery.img || abort "- I cannot repack the $name$slot image."
 
-	   # flash both slots
-	   for slot in _a _b; do
-		ui_print "- Installing OrangeFox to $name$slot..."
-		PART=$target"$slot"
-		blockdev --setrw $PART
-		package_extract_file "new_recovery.img" "$PART"
-	   done
+	   # flash current slot
+	   ui_print "- Installing OrangeFox to $name$slot..."
+	   PART=$target"$slot"
+	   image_size=$(wc -c < new_recovery.img)
+	   partition_size=$(blockdev --getsize64 "$PART")
+	   [ "$image_size" -le "$partition_size" ] || abort "vendor_boot image too large"
+	   blockdev --setrw "$PART" || abort "Cannot write vendor_boot"
+	   package_extract_file "new_recovery.img" "$PART" || abort "vendor_boot write failed"
 
 	   "$tool" cleanup
 	   rm -f $name".img"
 	   rm -f "new_recovery.img"
-	   mv -f fox_vendor_ramdisk $F_RAM
+	   mv -f fox_vendor_ramdisk vendor_ramdisk_recovery.cpio
 	   return
    	   # -----------------------------------------------------
 	fi
